# Configurazione della build per l'app Android/iOS (pnpm mobile:build).
# Copia questo file in .env.mobile.local (nella radice del repo, accanto a .env) e completa i valori.
#
# Dentro l'app non c'e' il proxy di Vite: le chiamate vanno all'API pubblica.
# Indirizzo del portale pubblicato su Vercel, senza "/" finale:
VITE_API_URL=https://INDIRIZZO-DEL-PORTALE.vercel.app
# Lo stesso indirizzo, usato per i link da condividere (es. inviti ai docenti):
VITE_PUBLIC_URL=https://INDIRIZZO-DEL-PORTALE.vercel.app
#
# Le chiavi Supabase vengono gia' lette dal file .env nella radice del repo.
#
# Notifiche push: metti 1 SOLO dopo aver copiato google-services.json in
# apps/web/android/app/ (senza quel file l'app si chiuderebbe all'avvio delle notifiche).
VITE_PUSH_ENABLED=0
